# Required for secure signed sessions
JWT_SECRET=replace-with-a-long-random-secret

# Required for PIN access
AUTH_PIN=replace-with-a-strong-unique-pin

# Required for MongoDB-backed customer orders and admin order viewing
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/obisnackspot?retryWrites=true&w=majority

# Required admin credentials
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@obisnackspot.com
ADMIN_PASSWORD=replace-with-a-strong-unique-password

# Optional Google OAuth configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://your-domain.example/api/auth/google/callback

# Set to true only when the site is served over HTTPS
COOKIE_SECURE=false
PORT=3000
NODE_ENV=development
